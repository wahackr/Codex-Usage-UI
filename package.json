{
  "name": "codex-usage-widget",
  "version": "1.0.0",
  "description": "Cross-platform desktop widget for ChatGPT plan Codex usage limits",
  "homepage": "https://github.com/wahackr/Codex-Usage-UI",
  "author": {
    "name": "Wahackr"
  },
  "main": "src/main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "generate:icon": "node scripts/generate-tray-icon.cjs",
    "prestart": "node scripts/generate-tray-icon.cjs",
    "fix:linux-sandbox": "bash scripts/fix-linux-sandbox.sh",
    "test": "node test/codex-client.test.cjs",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.codexusagewidget",
    "productName": "Codex Usage Widget",
    "files": ["src/**/*", "package.json"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Development" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
