<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexUsageWidget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Codex Usage">
  <!-- Layout ported from src/renderer/index.html + styles.css. The strip is
       the mini-mode row; it stays collapsed until mini mode is switched on.
       Colour uses the WinUI 3 Fluent theme brushes instead of the ported palette, and the
       icon buttons draw PathIcon geometry rather than the ▤/↻/▢ characters -
       WinUI has no font-fallback chain, so those codepoints render as boxes. -->
  <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <StackPanel x:Name="FullView" Padding="25,27,25,22">
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="CHATGPT PLAN" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                     FontSize="10" FontWeight="800" CharacterSpacing="180" />
          <TextBlock Text="Codex usage" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                     FontSize="27" FontWeight="SemiBold" CharacterSpacing="-40" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="MiniButton" Style="{StaticResource IconButtonStyle}"
                  ToolTipService.ToolTip="Mini mode" AutomationProperties.Name="Toggle mini mode"
                  Click="OnMiniClick">
            <PathIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                      Data="M3 6 H21 V13 H3 Z M3 16 H21 V19 H3 Z" />
          </Button>
          <!-- PathIcon has no FillRule member (WMC0011), so the ring is one
               closed band subpath - outer arc, radial step in, inner arc back -
               with the arrowhead as a second subpath that unions under the
               default non-zero rule. -->
          <Button x:Name="RefreshButton" Style="{StaticResource IconButtonStyle}"
                  ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh"
                  Click="OnRefreshClick">
            <PathIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                      Data="M8.92 3.54 A9 9 0 1 0 17.79 5.11 L15.86 7.40 A6 6 0 1 1 9.95 6.36 Z M20.47 7.36 L15.86 7.41 L19.72 2.81 Z" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid x:Name="StatusRow" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0"
                 VerticalAlignment="Center" Style="{StaticResource DotWarnStyle}" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Connecting…"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
      </Grid>

      <StackPanel Spacing="11">
        <Border Style="{StaticResource MeterCardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="5-hour window" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                <TextBlock x:Name="PrimaryRemaining" Text="—" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           FontSize="25" FontWeight="SemiBold" CharacterSpacing="-40" />
              </StackPanel>
              <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PillStyle}">
                <TextBlock x:Name="PrimaryLeft" Text="—" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Border>
            </Grid>
            <Border x:Name="PrimaryTrack" Height="8" Margin="0,14,0,8" CornerRadius="99"
                    Background="{ThemeResource ControlFillColorDisabledBrush}">
              <Border x:Name="PrimaryBar" Width="0" Height="8" HorizontalAlignment="Left"
                      CornerRadius="99" Style="{StaticResource BarNormalStyle}" />
            </Border>
            <TextBlock x:Name="PrimaryReset" Text="Waiting for live usage"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource MeterCardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Weekly window" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                <TextBlock x:Name="SecondaryRemaining" Text="—" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           FontSize="25" FontWeight="SemiBold" CharacterSpacing="-40" />
              </StackPanel>
              <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PillStyle}">
                <TextBlock x:Name="SecondaryLeft" Text="—" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Border>
            </Grid>
            <Border x:Name="SecondaryTrack" Height="8" Margin="0,14,0,8" CornerRadius="99"
                    Background="{ThemeResource ControlFillColorDisabledBrush}">
              <Border x:Name="SecondaryBar" Width="0" Height="8" HorizontalAlignment="Left"
                      CornerRadius="99" Style="{StaticResource BarNormalStyle}" />
            </Border>
            <TextBlock x:Name="SecondaryReset" Text="Waiting for live usage"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Three Fluent tiles with real gaps: XAML does not clip children to a
           CornerRadius, so the old single container let the square fact cells
           stick out of its rounded corners. -->
      <Grid Margin="0,11,0,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10,11">
          <StackPanel>
            <TextBlock Text="Plan" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" TextAlignment="Center" />
            <TextBlock x:Name="PlanValue" Text="—" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10,11">
          <StackPanel>
            <TextBlock Text="Credits" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" TextAlignment="Center" />
            <TextBlock x:Name="CreditsValue" Text="—" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10,11">
          <StackPanel>
            <TextBlock Text="Reset passes" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" TextAlignment="Center" />
            <TextBlock x:Name="ResetCreditsValue" Text="—" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Margin="0,16,0,0">
        <StackPanel Orientation="Horizontal" Spacing="15">
          <CheckBox x:Name="AlwaysOnTopToggle" Content="Always on top" Style="{StaticResource FooterCheckBoxStyle}"
                    Click="OnAlwaysOnTopClick" />
          <CheckBox x:Name="OpenAtLoginToggle" Content="Launch at login" Style="{StaticResource FooterCheckBoxStyle}"
                    Click="OnOpenAtLoginClick" />
        </StackPanel>
        <StackPanel x:Name="ThemePicker" Orientation="Horizontal" Spacing="6" Margin="0,14,0,0">
          <Button x:Name="ThemeAutoButton" Tag="system" Content="Auto" Style="{StaticResource ThemePillStyle}" Click="OnThemeClick" />
          <Button x:Name="ThemeLightButton" Tag="light" Content="Light" Style="{StaticResource ThemePillStyle}" Click="OnThemeClick" />
          <Button x:Name="ThemeDarkButton" Tag="dark" Content="Dark" Style="{StaticResource ThemePillStyle}" Click="OnThemeClick" />
        </StackPanel>
        <HyperlinkButton x:Name="OpenUsageLink" Margin="0,15,0,0" Content="Open Usage settings ↗"
                         Style="{StaticResource LinkStyle}" Click="OnOpenUsageClick" />
        <TextBlock x:Name="UpdatedText" Text="Not updated yet" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </StackPanel>

    <Border x:Name="Strip" Height="46" Padding="10,0" VerticalAlignment="Top"
            Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- The 1.7 Windows App SDK this app pins has no SvgImage control (CS0234
             on the generated MainWindow.g.i.cs), so the OpenAI mark is inlined as
             PathIcon geometry ported from the OpenAI SVG mark (24x24 design grid,
             same as the other glyphs here). Foreground tracks TextFillColorPrimary
             Brush, near-black in light mode and white in dark mode - the same
             light/dark swap the two SVG assets used to encode. -->
        <PathIcon x:Name="StripLogo" Width="20" Height="20" VerticalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" AutomationProperties.Name="OpenAI"
                  Data="M22.2819 9.8211 A5.9847 5.9847 0 0 0 21.7662 4.9103 A6.0462 6.0462 0 0 0 15.2564 2.0103 A6.0651 6.0651 0 0 0 4.9807 4.1818 A5.9847 5.9847 0 0 0 0.983 7.0818 A6.0462 6.0462 0 0 0 1.7257 14.1784 A5.98 5.98 0 0 0 2.2367 19.0891 A6.051 6.051 0 0 0 8.7513 21.9892 A5.9847 5.9847 0 0 0 13.2599 24 A6.0557 6.0557 0 0 0 19.0317 19.7942 A5.9894 5.9894 0 0 0 23.0294 16.8941 A6.0557 6.0557 0 0 0 22.2819 9.8212 Z M13.2599 22.4293 A4.4755 4.4755 0 0 1 10.3835 21.3885 L10.5254 21.3081 L15.3037 18.5499 A0.7948 0.7948 0 0 0 15.6964 17.8686 V11.1317 L17.7164 12.3003 A0.071 0.071 0 0 1 17.7544 12.3523 V17.9349 A4.504 4.504 0 0 1 13.2599 22.4293 Z M3.5992 18.3039 A4.4708 4.4708 0 0 1 3.0646 15.2902 L3.2066 15.3754 L7.9896 18.1336 A0.7712 0.7712 0 0 0 8.7702 18.1336 L14.613 14.7651 V17.0975 A0.0804 0.0804 0 0 1 14.5798 17.159 L9.74 19.9502 A4.4992 4.4992 0 0 1 3.5992 18.3038 Z M2.3408 7.8956 A4.485 4.485 0 0 1 4.7063 5.9228 V11.6 A0.7664 0.7664 0 0 0 5.0942 12.2765 L10.9086 15.6308 L8.8885 16.7993 A0.0757 0.0757 0 0 1 8.8175 16.7993 L3.9872 14.0128 A4.504 4.504 0 0 1 2.3408 7.872 Z M18.9371 11.7278 L13.1038 8.364 L15.1192 7.2 A0.0757 0.0757 0 0 1 15.1902 7.2 L20.0205 9.9913 A4.4944 4.4944 0 0 1 19.344 18.0955 V12.4183 A0.79 0.79 0 0 0 18.937 11.7513 Z M20.9477 8.7282 L20.8057 8.643 L16.0322 5.8612 A0.7759 0.7759 0 0 0 15.2468 5.8612 L9.409 9.2297 V6.8974 A0.0662 0.0662 0 0 1 9.4374 6.8359 L14.2677 4.0493 A4.4992 4.4992 0 0 1 20.9479 8.7093 Z M8.3065 12.863 L6.2865 11.6992 A0.0804 0.0804 0 0 1 6.2485 11.6425 V6.0742 A4.4992 4.4992 0 0 1 13.6242 2.6205 L13.4822 2.701 L8.704 5.459 A0.7948 0.7948 0 0 0 8.3113 6.1403 Z M9.4089 3.7749 L12.0109 2.2751 L14.6178 3.7749 V6.7743 L12.0204 8.274 L9.4137 6.7743 Z" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock x:Name="StripPrimary" Text="—" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                     FontSize="15" FontWeight="SemiBold" CharacterSpacing="-30" />
          <TextBlock Text="5H" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" CharacterSpacing="80" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock x:Name="StripSecondary" Text="—" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                     FontSize="15" FontWeight="SemiBold" CharacterSpacing="-30" />
          <TextBlock Text="WEEK" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" CharacterSpacing="80" />
        </StackPanel>
        <TextBlock x:Name="StripReset" Grid.Column="3" Text="—" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Ellipse x:Name="StripDot" Grid.Column="4" Width="7" Height="7"
                 VerticalAlignment="Center" Style="{StaticResource DotWarnStyle}" />
        <!-- Four corner brackets: an "expand" glyph (exit mini mode). -->
        <Button x:Name="ExpandButton" Grid.Column="5" Width="26" Height="26" Padding="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                ToolTipService.ToolTip="Exit mini mode" AutomationProperties.Name="Exit mini mode"
                Click="OnExpandClick">
          <PathIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Data="M4 4 H9 V6 H6 V9 H4 Z M20 4 H15 V6 H18 V9 H20 Z M4 20 H9 V18 H6 V15 H4 Z M20 20 H15 V18 H18 V15 H20 Z" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
