<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexUsageWidget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Codex Usage">
  <!-- Layout ported from src/renderer/index.html + styles.css. The strip is
       the mini-mode row; it stays collapsed until mini mode is switched on.
       Colour is the WinUI 3 Fluent vocabulary (SystemBaseColor, SystemSubtleSurface,
       SystemSeparator, AccentColor, ...) instead of the ported palette, and the
       icon buttons draw PathIcon geometry rather than the ▤/↻/▢ characters -
       WinUI has no font-fallback chain, so those codepoints render as boxes. -->
  <Grid x:Name="Root" Background="{ThemeResource SystemBaseColor}">
    <StackPanel x:Name="FullView" Padding="25,27,25,22">
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="CHATGPT PLAN" Foreground="{ThemeResource AccentColor}"
                     FontSize="10" FontWeight="800" CharacterSpacing="180" />
          <TextBlock Text="Codex usage" Foreground="{ThemeResource SystemTextColor}"
                     FontSize="27" FontWeight="SemiBold" CharacterSpacing="-40" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="MiniButton" Style="{StaticResource IconButtonStyle}"
                  ToolTipService.ToolTip="Mini mode" AutomationProperties.Name="Toggle mini mode"
                  Click="OnMiniClick">
            <PathIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{ThemeResource SystemTextColor}"
                      Data="M3 6 H21 V13 H3 Z M3 16 H21 V19 H3 Z" />
          </Button>
          <Button x:Name="RefreshButton" Style="{StaticResource IconButtonStyle}"
                  ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh"
                  Click="OnRefreshClick">
            <PathIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{ThemeResource SystemTextColor}" FillRule="EvenOdd"
                      Data="M12 3 A9 9 0 0 1 12 21 A9 9 0 0 1 12 3 Z M12 6 A6 6 0 0 1 12 18 A6 6 0 0 1 12 6 Z M18.5 1 L23 5.5 L17.5 4.5 Z" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid x:Name="StatusRow" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0"
                 VerticalAlignment="Center" Style="{StaticResource DotWarnStyle}" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Connecting…"
                   Foreground="{ThemeResource SystemSecondaryTextColor}" FontSize="12" TextWrapping="Wrap" />
      </Grid>

      <StackPanel Spacing="11">
        <Border Style="{StaticResource MeterCardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="5-hour window" Foreground="{ThemeResource SystemSecondaryTextColor}" FontSize="12" />
                <TextBlock x:Name="PrimaryRemaining" Text="—" Foreground="{ThemeResource SystemTextColor}"
                           FontSize="25" FontWeight="SemiBold" CharacterSpacing="-40" />
              </StackPanel>
              <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PillStyle}">
                <TextBlock x:Name="PrimaryLeft" Text="—" FontSize="11"
                           Foreground="{ThemeResource SystemSecondaryTextColor}" />
              </Border>
            </Grid>
            <Border x:Name="PrimaryTrack" Height="8" Margin="0,14,0,8" CornerRadius="99"
                    Background="{ThemeResource SystemDisabledControl}">
              <Border x:Name="PrimaryBar" Width="0" Height="8" HorizontalAlignment="Left"
                      CornerRadius="99" Style="{StaticResource BarNormalStyle}" />
            </Border>
            <TextBlock x:Name="PrimaryReset" Text="Waiting for live usage"
                       Foreground="{ThemeResource SystemSecondaryTextColor}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource MeterCardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Weekly window" Foreground="{ThemeResource SystemSecondaryTextColor}" FontSize="12" />
                <TextBlock x:Name="SecondaryRemaining" Text="—" Foreground="{ThemeResource SystemTextColor}"
                           FontSize="25" FontWeight="SemiBold" CharacterSpacing="-40" />
              </StackPanel>
              <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PillStyle}">
                <TextBlock x:Name="SecondaryLeft" Text="—" FontSize="11"
                           Foreground="{ThemeResource SystemSecondaryTextColor}" />
              </Border>
            </Grid>
            <Border x:Name="SecondaryTrack" Height="8" Margin="0,14,0,8" CornerRadius="99"
                    Background="{ThemeResource SystemDisabledControl}">
              <Border x:Name="SecondaryBar" Width="0" Height="8" HorizontalAlignment="Left"
                      CornerRadius="99" Style="{StaticResource BarNormalStyle}" />
            </Border>
            <TextBlock x:Name="SecondaryReset" Text="Waiting for live usage"
                       Foreground="{ThemeResource SystemSecondaryTextColor}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Three Fluent tiles with real gaps: XAML does not clip children to a
           CornerRadius, so the old single container let the square fact cells
           stick out of its rounded corners. -->
      <Grid Margin="0,11,0,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border CornerRadius="8" Background="{ThemeResource SystemSubtleSurface}"
                BorderBrush="{ThemeResource SystemSeparator}" BorderThickness="1" Padding="10,11">
          <StackPanel>
            <TextBlock Text="Plan" Foreground="{ThemeResource SystemSecondaryTextColor}" FontSize="10" TextAlignment="Center" />
            <TextBlock x:Name="PlanValue" Text="—" Foreground="{ThemeResource SystemTextColor}"
                       FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource SystemSubtleSurface}"
                BorderBrush="{ThemeResource SystemSeparator}" BorderThickness="1" Padding="10,11">
          <StackPanel>
            <TextBlock Text="Credits" Foreground="{ThemeResource SystemSecondaryTextColor}" FontSize="10" TextAlignment="Center" />
            <TextBlock x:Name="CreditsValue" Text="—" Foreground="{ThemeResource SystemTextColor}"
                       FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" CornerRadius="8" Background="{ThemeResource SystemSubtleSurface}"
                BorderBrush="{ThemeResource SystemSeparator}" BorderThickness="1" Padding="10,11">
          <StackPanel>
            <TextBlock Text="Reset passes" Foreground="{ThemeResource SystemSecondaryTextColor}" FontSize="10" TextAlignment="Center" />
            <TextBlock x:Name="ResetCreditsValue" Text="—" Foreground="{ThemeResource SystemTextColor}"
                       FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Margin="0,16,0,0">
        <StackPanel Orientation="Horizontal" Spacing="15">
          <CheckBox x:Name="AlwaysOnTopToggle" Content="Always on top" Style="{StaticResource FooterCheckBoxStyle}"
                    Click="OnAlwaysOnTopClick" />
          <CheckBox x:Name="OpenAtLoginToggle" Content="Launch at login" Style="{StaticResource FooterCheckBoxStyle}"
                    Click="OnOpenAtLoginClick" />
        </StackPanel>
        <StackPanel x:Name="ThemePicker" Orientation="Horizontal" Spacing="6" Margin="0,14,0,0">
          <Button x:Name="ThemeAutoButton" Tag="system" Content="Auto" Style="{StaticResource ThemePillStyle}" Click="OnThemeClick" />
          <Button x:Name="ThemeLightButton" Tag="light" Content="Light" Style="{StaticResource ThemePillStyle}" Click="OnThemeClick" />
          <Button x:Name="ThemeDarkButton" Tag="dark" Content="Dark" Style="{StaticResource ThemePillStyle}" Click="OnThemeClick" />
        </StackPanel>
        <HyperlinkButton x:Name="OpenUsageLink" Margin="0,15,0,0" Content="Open Usage settings ↗"
                         Style="{StaticResource LinkStyle}" Click="OnOpenUsageClick" />
        <TextBlock x:Name="UpdatedText" Text="Not updated yet" Foreground="{ThemeResource SystemTertiaryTextColor}"
                   FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </StackPanel>

    <Border x:Name="Strip" Height="46" Padding="10,0" VerticalAlignment="Top"
            Visibility="Collapsed" Background="{ThemeResource SystemSubtleSurface}"
            BorderBrush="{ThemeResource SystemSeparator}" BorderThickness="0,0,0,1">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <PathIcon Width="20" Height="20" VerticalAlignment="Center" Foreground="{ThemeResource SystemTextColor}"
                  AutomationProperties.Name="OpenAI" Data="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock x:Name="StripPrimary" Text="—" Foreground="{ThemeResource SystemTextColor}"
                     FontSize="15" FontWeight="SemiBold" CharacterSpacing="-30" />
          <TextBlock Text="5H" Foreground="{ThemeResource SystemSecondaryTextColor}" FontSize="10" CharacterSpacing="80" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock x:Name="StripSecondary" Text="—" Foreground="{ThemeResource SystemTextColor}"
                     FontSize="15" FontWeight="SemiBold" CharacterSpacing="-30" />
          <TextBlock Text="WEEK" Foreground="{ThemeResource SystemSecondaryTextColor}" FontSize="10" CharacterSpacing="80" />
        </StackPanel>
        <TextBlock x:Name="StripReset" Grid.Column="3" Text="—" Foreground="{ThemeResource SystemSecondaryTextColor}"
                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Ellipse x:Name="StripDot" Grid.Column="4" Width="7" Height="7"
                 VerticalAlignment="Center" Style="{StaticResource DotWarnStyle}" />
        <Button x:Name="ExpandButton" Grid.Column="5" Width="26" Height="26" Padding="0"
                Background="{ThemeResource SystemSubtleSurface}" BorderBrush="{ThemeResource SystemSeparator}"
                BorderThickness="1" CornerRadius="8"
                ToolTipService.ToolTip="Exit mini mode" AutomationProperties.Name="Exit mini mode"
                Click="OnExpandClick">
          <PathIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemTextColor}" FillRule="EvenOdd"
                    Data="M3 3 H21 V21 H3 Z M7 7 H17 V17 H7 Z" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
