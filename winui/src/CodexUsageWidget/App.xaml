<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CodexUsageWidget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Native Fluent look: colour comes from the WinUI 3 theme brushes
       (SolidBackgroundFillColorBaseBrush, TextFillColorPrimaryBrush, ...) rather than the
       palette ported from styles.css, so the OS accent and the OS light/dark
       mode drive the whole surface and Root.RequestedTheme still forces Light
       or Dark for the Auto/Light/Dark override. Only the two semantic state
       colours are hand-picked - the Fluent dictionaries carry no warning or
       danger token - and they keep a light and dark variant for contrast. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WarnBrush" Color="#ffbf69" />
          <SolidColorBrush x:Key="DangerBrush" Color="#ff716d" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WarnBrush" Color="#a86a10" />
          <SolidColorBrush x:Key="DangerBrush" Color="#c0403b" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="WarnBrush" Color="#ffbf69" />
          <SolidColorBrush x:Key="DangerBrush" Color="#ff716d" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- State styles use ThemeResource setters so they re-resolve when the
           palette flips; code-behind swaps Style instead of setting brushes
           directly, which would freeze the current palette. -->
      <Style x:Key="DotWarnStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource WarnBrush}" />
      </Style>
      <Style x:Key="DotLiveStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
      </Style>
      <Style x:Key="DotErrorStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource DangerBrush}" />
      </Style>
      <Style x:Key="BarNormalStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
      </Style>
      <Style x:Key="BarWarnStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WarnBrush}" />
      </Style>
      <Style x:Key="BarDangerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DangerBrush}" />
      </Style>
      <Style x:Key="ChipInkStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </Style>
      <Style x:Key="ChipWarnStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource WarnBrush}" />
      </Style>
      <Style x:Key="ChipDangerStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
      </Style>
      <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </Style>
      <Style x:Key="MeterCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
      </Style>
      <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,5" />
      </Style>
      <Style x:Key="FooterCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style x:Key="ThemePillStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </Style>
      <Style x:Key="ThemePillActiveStyle" TargetType="Button" BasedOn="{StaticResource ThemePillStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </Style>
      <Style x:Key="LinkStyle" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
