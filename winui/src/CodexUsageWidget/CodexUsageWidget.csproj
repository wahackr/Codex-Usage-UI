<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unpackaged WinUI 3 app (Windows App SDK). Ships as a self-contained
       win-x64 build behind an Inno Setup installer; no MSIX identity. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>CodexUsageWidget</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The self-contained Windows App SDK runtime is unpacked from an MSIX
         for one architecture, and the SDK errors out unless the build names
         one. A plain `dotnet build` defaults to AnyCPU, so pin the RID the
         installer ships (same as the publish command in release.yml). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexUsageWidget.Core\CodexUsageWidget.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Tinted tray icons generated by scripts/generate-tray-icon.cjs. -->
    <Content Include="..\..\assets\tray-*.ico" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The SDK publish list omits the unpackaged app's compiled XAML and PRI.
       Include them explicitly so publish output can load MainWindow. -->
  <Target Name="PublishAppXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <AppXamlResource Include="$(TargetDir)**\*.xbf;$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(AppXamlResource)"
          DestinationFiles="@(AppXamlResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
